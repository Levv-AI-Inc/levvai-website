# Set this only for local development. Next.js proxies unmatched backend routes
# to Django while keeping browser cookies and CSRF requests same-origin.
LOCAL_BACKEND_URL=http://127.0.0.1:8000

# Flow Studio, in real mode (docs/flow-studio/IMPLEMENTATION_NOTES.md, "Deployment prerequisites").
# FLOW_STUDIO_STORE=django
# FLOW_STUDIO_BACKEND_URL=http://127.0.0.1:8000
# FLOW_STUDIO_STORE_TOKEN=          the same value as on the backend
# LEVV_SERVICE_TOKEN=               header x-levv-service-token on POST /api/runtime/events
# LEVV_CRON_SECRET=                 header x-levv-cron-secret on POST /api/runtime/tick
# LEVV_MOCK_AUTOCOMPLETE=1          development only. A production process ignores it.

# Incomplete Supplier and User Management MVP flows remain disabled by default.
NEXT_PUBLIC_FEATURE_USER_DETAIL_V2=false
NEXT_PUBLIC_FEATURE_USER_ACCESS_MANAGEMENT=false
NEXT_PUBLIC_FEATURE_SUPPLIER_DETAIL_V2=false
NEXT_PUBLIC_FEATURE_SUPPLIER_COVERAGE=false
NEXT_PUBLIC_FEATURE_SUPPLIER_RATE_CARDS_V2=false
NEXT_PUBLIC_FEATURE_AGREEMENT_EXTRACTION=false
NEXT_PUBLIC_FEATURE_DETERMINISTIC_RATE_RESOLUTION=false
