  "DWX": {
    "brief": {
      "d": "Writes a short brief for each approver: what is being asked, what changed since last time, and anything unusual.",
      "u": "Drop it on an Approve step."
    },
    "rate": {
      "d": "Compares the bill rate with your rate card and the market.",
      "u": "Put it on the line before an approver. Two exits: Passed and Flagged."
    },
    "budget": {
      "d": "Checks how much budget is left on the cost center, plan or contract after this request.",
      "u": "Put it on the line before an approver. Two exits: Passed and Flagged. Every approver sees the result in their brief."
    },
    "dup": {
      "d": "Looks for the same person already working through another supplier, or old access never removed.",
      "u": "Two exits: Passed and Flagged. Use Flagged to escalate to someone who must decide."
    },
    "tenure": {
      "d": "Counts how long the worker has been engaged and warns before tenure or classification limits.",
      "u": "Two exits: Passed and Flagged."
    },
    "chaser": {
      "d": "Reminds people about anything due, then escalates to their manager when time limits pass.",
      "u": "Add it anywhere in a workflow."
    },
    "intake": {
      "d": "Turns a hiring manager’s plain description into a complete job posting with the right job family and rate range.",
      "u": "Add it to a Job posting workflow."
    },
    "invoice": {
      "d": "Matches each invoice line to approved time, expenses and milestones, and holds anything that doesn’t match.",
      "u": "Add it to an Invoice workflow. Needs the S/4HANA connection."
    },
    "docs": {
      "d": "Asks the worker for documents, checks they are valid and readable, and chases what is missing.",
      "u": "Drop it on a Collect & verify step."
    },
    "access": {
      "d": "Requests accounts and access in Okta or ServiceNow, only what the role needs, and records each one in the ledger.",
      "u": "Drop it on a System step."
    },
    "startguard": {
      "d": "Watches every onboarding item against the start date and warns early if the date is at risk, with who to chase.",
      "u": "Add it to an Onboarding workflow."
    },
    "sweeper": {
      "d": "Removes every account and access recorded in the ledger, then searches connected systems for anything missed (ghost access).",
      "u": "Drop it on a System step in Offboarding."
    },
    "recovery": {
      "d": "Arranges laptop and badge returns, sends courier labels and chases until everything is back.",
      "u": "Add it to an Offboarding workflow."
    },
    "closer": {
      "d": "Makes sure the final timesheet, expenses and invoice are in before the work order is closed.",
      "u": "Add it to an Offboarding workflow."
    }
  },
